{
  "name": "@grabber/desktop",
  "productName": "Grabber",
  "version": "0.2.0",
  "private": true,
  "description": "Download videos, HLS streams and files with multipart, pause/resume and a video-detecting browser.",
  "author": {
    "name": "Mohit Yadav",
    "email": "mohit@heygeeks.in"
  },
  "homepage": "mailto:mohit@heygeeks.in",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node init && node build.mjs",
    "typecheck": "tsc --noEmit -p ../..",
    "start": "node init && node build.mjs && electron .",
    "selftest": "node build.mjs && GRABBER_SELFTEST=1 electron .",
    "icons": "electron scripts/make-icon.cjs",
    "dist": "node scripts/package.mjs",
    "pack": "node scripts/package.mjs --dir"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@grabber/core": "*",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "in.heygeeks.grabber",
    "productName": "Grabber",
    "copyright": "Copyright \u00a9 2026 Mohit Yadav",
    "files": [
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "extraMetadata": {
      "main": "dist/main.cjs"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Mohit Yadav <mohit@heygeeks.in>"
    },
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    }
  }
}
